#!/usr/bin/env python3
"""grab: download videos from any site yt-dlp supports and transcribe them locally.

Usage: grab [options] URL [URL ...]

Each video lands in OUT/<uploader>_<id>/ with video.<ext>, video.info.json and
transcript.txt. The directory of each finished video is printed on stdout, one per
line; progress and errors go to stderr. Exit status is 1 if any URL failed.

Environment:
  GRAB_YTDLP     yt-dlp command (default: latest release through uvx, else yt-dlp)
  GRAB_STT_CMD   speech-to-text command: takes a WAV path, prints the text (default: stt-file)
"""
import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Audio shorter than this share of the video means a broken audio track. TikTok serves
# H.265 video-only formats plus a separate "audio" format that can be a 2-second stub,
# and yt-dlp merges the two by default.
MIN_AUDIO_RATIO = 0.9


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def ytdlp_cmd():
    env = os.environ.get("GRAB_YTDLP")
    if env:
        return shlex.split(env)
    # Sites like TikTok and Instagram break old extractors often: prefer the latest release.
    if shutil.which("uvx"):
        return ["uvx", "--quiet", "--from", "yt-dlp[default]@latest", "yt-dlp"]
    if shutil.which("yt-dlp"):
        return ["yt-dlp"]
    sys.exit("grab: neither uvx nor yt-dlp is on PATH")


def stt_cmd():
    return shlex.split(os.environ.get("GRAB_STT_CMD", "stt-file"))


def read_url_file(path):
    urls = []
    for line in Path(path).read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            urls.append(line)
    return urls


def probe_durations(path):
    """Return (video_seconds, audio_seconds); None when a stream is missing."""
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "stream=codec_type,duration",
         "-show_entries", "format=duration", "-of", "json", str(path)],
        capture_output=True, text=True, check=True).stdout
    data = json.loads(out)
    fmt = float(data.get("format", {}).get("duration") or 0) or None
    video = audio = None
    for s in data.get("streams", []):
        d = float(s.get("duration") or 0) or None
        if s.get("codec_type") == "video" and video is None:
            video = d or fmt
        elif s.get("codec_type") == "audio" and audio is None:
            audio = d or fmt
    return video, audio


def audio_ok(path):
    video, audio = probe_durations(path)
    if audio is None:
        return False
    if video is None:  # audio-only download
        return True
    return audio >= MIN_AUDIO_RATIO * video


def download(url, out, cookies, fmt=None):
    cmd = ytdlp_cmd() + [
        "--quiet", "--no-warnings", "--no-simulate", "--no-playlist", "--write-info-json",
        "-o", f"{out}/%(uploader)s_%(id)s/video.%(ext)s",
        "--print", "after_move:filepath",
    ]
    if cookies:
        cmd += ["--cookies-from-browser", cookies]
    if fmt:
        cmd += ["-f", fmt]
    res = subprocess.run(cmd + [url], stdout=subprocess.PIPE, text=True)
    lines = [l for l in res.stdout.splitlines() if l.strip()]
    if res.returncode != 0 or not lines:
        return None
    return Path(lines[-1])


def transcribe(media, chunk_seconds):
    """Cut the audio into chunk_seconds blocks and run the STT command on each one.

    Many local models have a maximum input length (Nemotron streaming stops near 6.5
    minutes), so long videos must go in blocks. A cut can split a word in two."""
    with tempfile.TemporaryDirectory(prefix="grab-") as tmp:
        subprocess.run(
            ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(media), "-vn",
             "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", "-f", "segment",
             "-segment_time", str(chunk_seconds), f"{tmp}/chunk%04d.wav"],
            check=True)
        parts = []
        for chunk in sorted(Path(tmp).glob("chunk*.wav")):
            res = subprocess.run(stt_cmd() + [str(chunk)], stdout=subprocess.PIPE, text=True)
            if res.returncode != 0:
                raise RuntimeError(f"STT command failed on {chunk.name} (exit {res.returncode})")
            text = res.stdout.strip()
            if text:
                parts.append(text)
        return "\n".join(parts)


def grab_one(url, args):
    log(f"== {url}")
    media = download(url, args.output, args.cookies_from_browser)
    if media is None:
        log(f"grab: download failed: {url}")
        if not args.cookies_from_browser:
            log("      if the site asks for a login, retry with --cookies-from-browser <browser>")
        return None
    if not audio_ok(media):
        log("   audio track missing or cut short: downloading a format with its own audio")
        # Delete first: yt-dlp skips a download whose output file already exists.
        media.unlink(missing_ok=True)
        media = download(url, args.output, args.cookies_from_browser, fmt="b")
        if media is None or not audio_ok(media):
            log(f"grab: no format with complete audio: {url}")
            return None
    folder = media.parent
    if args.transcribe:
        try:
            text = transcribe(media, args.chunk)
        except (RuntimeError, subprocess.CalledProcessError) as e:
            log(f"grab: transcription failed: {e}")
            return None
        (folder / "transcript.txt").write_text(text + "\n" if text else "")
        if text:
            log(f"   transcript: {folder / 'transcript.txt'} ({len(text.split())} words)")
        else:
            log("   transcript is empty: the video has no speech, or the STT heard none")
    if not args.keep_video:
        media.unlink(missing_ok=True)
    return folder


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="grab", description=__doc__.split("\n", 1)[0],
        epilog="Environment: GRAB_YTDLP, GRAB_STT_CMD (see README).")
    p.add_argument("urls", nargs="*", metavar="URL")
    p.add_argument("-o", "--output", default="grab_out", help="output root (default: grab_out)")
    p.add_argument("-f", "--file", help="read more URLs from FILE, one per line, # starts a comment")
    p.add_argument("--cookies-from-browser", metavar="BROWSER",
                   help="pass your browser login to yt-dlp (TikTok and Instagram often need it)")
    p.add_argument("--no-video", dest="keep_video", action="store_false",
                   help="delete the video after transcription")
    p.add_argument("--no-transcribe", dest="transcribe", action="store_false",
                   help="download only")
    p.add_argument("--chunk", type=int, default=300, metavar="SECONDS",
                   help="audio block length sent to the STT command (default: 300)")
    args = p.parse_args(argv)

    urls = list(args.urls)
    if args.file:
        urls += read_url_file(args.file)
    if not urls:
        p.error("give at least one URL, or -f FILE")
    if args.chunk <= 0:
        p.error("--chunk must be a positive number of seconds")
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            sys.exit(f"grab: {tool} is not on PATH")
    if args.transcribe and not shutil.which(stt_cmd()[0]):
        sys.exit(f"grab: STT command not found: {stt_cmd()[0]} (set GRAB_STT_CMD, "
                 "or use --no-transcribe)")

    failed = 0
    for url in urls:
        folder = grab_one(url, args)
        if folder is None:
            failed += 1
        else:
            print(folder, flush=True)
    if failed:
        log(f"grab: {failed} of {len(urls)} failed")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
