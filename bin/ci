#!/usr/bin/env bash
# Every check this repo has, in one command. .githooks/pre-push runs it before each push.
# Enable the hook once per clone: git config core.hooksPath .githooks
#
# Stages, in order; the first failure stops the run:
#   tools      python3, ffmpeg and ffprobe on PATH (the tests make real media files)
#   syntax     python3 -m py_compile on grab and the tests; bash -n on the shell files
#   leak scan  no home paths, LAN addresses or e-mail addresses in tracked files: the repo is public
#   tests      python3 -m unittest discover -s tests (offline, fake yt-dlp and STT)
#
# CI_MODE is accepted, not used: the whole run takes a few seconds.
set -euo pipefail
cd "$(dirname "$0")/.."

stage() { printf '== %s\n' "$1"; }
fail() {
  printf 'bin/ci: %s\n' "$1" >&2
  exit 1
}

stage tools
for t in python3 ffmpeg ffprobe; do
  command -v "$t" >/dev/null || fail "$t is not on PATH"
done

stage syntax
python3 -m py_compile grab tests/*.py tests/fakes/*.py
bash -n bin/ci .githooks/pre-push

stage "leak scan"
if git ls-files -z | xargs -0 grep -nIE '/home/[a-z]|/Users/[A-Za-z]|192\.168\.[0-9]|10\.[0-9]+\.[0-9]+\.[0-9]+|[A-Za-z0-9._%+-]+@(gmail|outlook|hotmail|icloud)\.com' 2>/dev/null; then
  fail "personal path, LAN address or e-mail address in a tracked file (lines above)"
fi

stage tests
python3 -m unittest discover -s tests

echo "bin/ci: all green"
